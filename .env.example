# =========================================================================
# Lexora Multi-Tenant SaaS Platform - Environment Configuration Template
# =========================================================================

# 1. Database Connections (Prisma PostgreSQL)
# For production Neon DB, use pooling URL for server and direct URL for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/lexora_db?schema=public"

# 2. Authentication & Token Signing
JWT_SECRET="generate_a_secure_random_string_using_openssl_rand_hex_64"

# 3. Payment Processing Gateway (Stripe Developer Console)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 4. OpenAI Cognitive Models API Key (OpenAI Developer Console)
OPENAI_API_KEY="sk-proj-..."

# 5. Dev Server Port
PORT=3000
